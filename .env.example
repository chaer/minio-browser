# ---------- MinIO 连接 ----------
# 如果 MinIO 和容器在同一台宿主机，Linux 可用 host.docker.internal:9000
# 或直接写宿主机内网 IP，如 192.168.1.100:9000
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_SECURE=false

# 逻辑桶名（物理盘 hdd1~hdd4 是纠删码阵列，不是桶）
MINIO_BUCKET=video

# 接口 file_url 形如 "public/2026/10/20/xxx.mp4"，本身就是 object_name，
# 所以这里必须留空。仅当 file_url 额外带了桶前缀时才填，如 "video/"
FILE_URL_PREFIX=

# ---------- 抓取接口用（仅 build-index 需要） ----------
DOUYOYO_TOKEN=your-token
PAGESIZE=120
MAX_PAGES=0
